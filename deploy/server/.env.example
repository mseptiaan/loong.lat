# Salin ke .env di server (chmod 600). Jangan pernah di-commit.
DOMAIN=loong.lat
# kosong = tag terbaru (:console-api, :web, ...); "-20261027" memakai tag bertanggal
IMAGE_SUFFIX=

# Postgres: kata sandi superuser dan kata sandi role tiap layanan (heksa, aman di URL)
POSTGRES_PASSWORD=
DB_PASSWORD=

# token antar-layanan (acak, panjang)
OPTIMIZER_TOKEN=
AI_TOKEN_CONSOLE=
AI_TOKEN_BACKOFFICE=
AI_TOKEN_OPTIMIZER=

# admin pertama backoffice (dibuat saat start bila belum ada)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=true

# Meta Model API (gerbang ai)
META_API_KEY=
META_BASE_URL=
META_MODEL=

# Modal + Mapbox (optimizer)
RUNNER=modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_VOLUME=loong-solver
MODAL_SOLVER_VERSION=
MAPBOX_TOKEN=
