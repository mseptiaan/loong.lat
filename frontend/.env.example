# Salin ke .env.local (diabaikan git). Dibaca hanya oleh host api.<domain> (api/vite.config.ts: envDir).
#
# Token PUBLIK Mapbox (awalan pk.). Dipakai untuk jarak lewat jalan (Matrix API) dan jalur jalan (Directions API).
# Kosong = jarak perkiraan dan garis halus (semua fitur tetap jalan, hanya rute tak mengikuti jalan).
# Batasi token di dashboard Mapbox (URL restrictions: loong.lat, *.loong.lat, *.loong.localhost).
VITE_MAPBOX_TOKEN=
