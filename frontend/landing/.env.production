# Alamat produksi tiap aplikasi (bukan rahasia). Build produksi halaman depan menautkan ke sini, apa pun host-nya.
# Saat dev (`npm run dev`) variabel ini tidak ada, jadi tautan diturunkan dari hostname: console.loong.localhost, dst.
VITE_CONSOLE_URL=https://console.loong.lat
VITE_BACKOFFICE_URL=https://backoffice.loong.lat
VITE_DRIVER_URL=https://driver.loong.lat
# Aplikasi produksi memakai backend Go (mode http): kalimat landing tentang demo menyesuaikan.
VITE_API_MODE=http
