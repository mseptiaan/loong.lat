# Settings shared by the services. Copy to .env (gitignored) for local development; a service also reads a .env
# in its own working directory. Real environment variables win over .env, and an empty value counts as unset.
# Never commit real values. The optimizer's own settings are in services/optimizer/.env.example.

# ---- every service -----------------------------------------------------------------------------------------
# Listen address. Every API has its own port and is reached directly (there is no gateway): driver-api :8081,
# backoffice-api :8082, console-api :8083, optimizer :8090.
HTTP_ADDR=
# debug | info | warn | error
LOG_LEVEL=info
# How long a sign-in lasts, in Go duration syntax (e.g. 720h).
SESSION_TTL=

# This service's own database only; each service has its own database and role. Local development (see
# scripts/dev-up.sh, which prints a working URL): postgres://<service>:<password>@127.0.0.1:55432/<service>
DATABASE_URL=

# Kafka bootstrap servers, comma-separated. Local Redpanda: localhost:19092
KAFKA_BROKERS=

# ---- local infrastructure (deploy/docker-compose.yml) ------------------------------------------------------
# Password of the development database roles; defaults to a fixed development value when empty.
LOONG_DEV_DB_PASSWORD=

# ---- tests ---------------------------------------------------------------------------------------------------
# Enables the database tests (they skip when empty). scripts/dev-up.sh prints a value for the local Postgres.
TEST_DATABASE_URL=

# Web origins allowed to call this service from a browser, comma separated and matched exactly. Each service answers
# its own preflights. Defaults to the service's own app on loong.localhost; in production, e.g. https://console.loong.lat.
CORS_ORIGINS=

# ---- console-api ---------------------------------------------------------------------------------------------
# Where the optimizer listens, and the bearer token it expects (OPTIMIZER_TOKEN in the optimizer's settings).
OPTIMIZER_URL=
OPTIMIZER_TOKEN=
# How long the console waits for a quote: more than the optimizer's OPTIMIZER_TIMEOUT_DEEP (150s). Empty keeps 3m.
OPTIMIZER_CALL_TIMEOUT=

# ---- optimizer (see services/optimizer/.env.example for all of its settings) ---------------------------------
# Limit of a thorough or reviewed quote (a fast one keeps OPTIMIZER_TIMEOUT), and the most review rounds of a
# reviewed quote. The optimizer also reads AI_URL and AI_TOKEN below.
OPTIMIZER_TIMEOUT_DEEP=
OPTIMIZER_ROUNDS=

# ---- backoffice-api ------------------------------------------------------------------------------------------
# Run the dispatch worker inside this process (it can be split out later).
DISPATCH_WORKER=true

# ---- ai (the Meta model gateway, services/ai) and its callers -------------------------------------------------
# The gateway is the only holder of the Meta key. Callers (console-api, backoffice-api, optimizer) give AI_URL (e.g.
# http://127.0.0.1:8091) and the bearer token the gateway expects; an empty AI_URL turns every AI feature off (the
# optimizer then reviews with its built-in rules).
AI_URL=
AI_TOKEN=
# The gateway's own settings. Real values only in your untracked .env, never here.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3-contributor
# Per-customer AI rate limit in console-api (requests per minute, burst).
AI_USER_RATE_PER_MINUTE=
AI_USER_RATE_BURST=
