# Settings of the optimizer service. Copy to .env (gitignored) for local development.
# Real environment variables win over .env. Never commit real values.

OPTIMIZER_ADDR=:8090
# Shared secret that console-api and backoffice-api present as a bearer token.
OPTIMIZER_TOKEN=
# Run without OPTIMIZER_TOKEN, for a laptop only.
OPTIMIZER_DEV=true
LOG_LEVEL=info

# Where jobs run: local (in this process), exec (the solver binary), modal (a Modal sandbox per job).
RUNNER=local
# exec: path of the solver binary (go build -o bin/solver ./services/optimizer/cmd/solver)
SOLVER_BIN=bin/solver
# modal: a sandbox that cannot be reached falls back to local unless set to "none".
OPTIMIZER_FALLBACK=
OPTIMIZER_CONCURRENCY=
# Limit of a fast quote. A thorough or reviewed quote runs several jobs and takes OPTIMIZER_TIMEOUT_DEEP; each job
# gets a share of what is left of it as its own limit, and a search that runs out of time answers with the best found.
OPTIMIZER_TIMEOUT=45s
OPTIMIZER_TIMEOUT_DEEP=150s
# Review rounds of a reviewed quote, at most.
OPTIMIZER_ROUNDS=3

# AI gateway (services/ai), which lets the model choose the next experiments of a reviewed quote. The optimizer is
# the gateway's third caller and presents its own token: one of the values in the gateway's AI_TOKEN list. Without
# AI_URL the built-in rules review. Real values only in your untracked .env.
AI_URL=
AI_TOKEN=

# Road data. Without a token distances are straight-line estimates.
MAPBOX_TOKEN=
ROAD_TIMEOUT=8s
ROAD_CACHE_TTL=24h
# No route may use a toll road: the table is measured with the Directions API (exclude=toll), a handful of requests
# for a quote, because the Matrix API cannot leave tolls out. true brings the Matrix API (and tolls) back.
ROAD_ALLOW_TOLLS=false

# Solver limits (empty = engine defaults). Jobs up to OPTIMIZER_EXACT_MAX shipments are also solved exhaustively.
OPTIMIZER_EXACT_MAX=
OPTIMIZER_ITERATIONS=

# Modal. Credentials come from these variables or ~/.modal.toml; keep them out of the repository.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP=loong-optimizer
MODAL_ENVIRONMENT=
# The solver reaches the sandbox through a Modal Volume (private to your workspace, no registry needed):
# scripts/publish-solver.sh uploads the binary and prints the version to set here.
MODAL_VOLUME=loong-solver
MODAL_SOLVER_VERSION=
# Or, instead of the Volume, an image in a PRIVATE registry that has the binary at /solver
# (MODE=registry scripts/publish-solver.sh <registry>/<repo>), plus a Modal Secret with the registry credentials.
MODAL_IMAGE=
MODAL_REGISTRY_SECRET=
MODAL_CPU=2
MODAL_MEMORY_MIB=1024
MODAL_TIMEOUT=90s
MODAL_REGIONS=
# Warm sandboxes: a job takes ~1 s in a warm sandbox and ~4.5 s in a cold one. An idle warm sandbox costs about
# $0.31 an hour until MODAL_IDLE_TIMEOUT ends it. MODAL_POOL_SIZE=0 starts a sandbox per job and costs nothing idle.
MODAL_POOL_SIZE=2
MODAL_IDLE_TIMEOUT=5m
MODAL_PREWARM=1
