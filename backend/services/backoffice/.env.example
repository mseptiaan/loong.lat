# backoffice-api. Copy to .env (gitignored) next to where you run it. Real environment variables win over .env, and
# an empty value counts as unset. The settings every service shares (HTTP_ADDR, LOG_LEVEL, SESSION_TTL,
# DATABASE_URL, KAFKA_BROKERS) are in backend/.env.example; DATABASE_URL must point at the backoffice database.
#
#   HTTP_ADDR      defaults to :8082
#   GROUP_PREFIX   consumer groups are <GROUP_PREFIX>.plans / .drivers / .positions / .execution / .customers;
#                  defaults to "backoffice"

# The admin account created at start when no admin has this email. Set both or neither. An account that already
# exists is left alone, password included. At least 8 characters; only its argon2id hash is stored.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Display name of that admin.
ADMIN_NAME=Admin

# Run the automatic dispatch worker in this process (default true; it can be split out later).
DISPATCH_WORKER=true

# Demo only: when the fleet is empty, create a motorbike and a blind van with their drivers (PIN in
# internal/fleet/seed.go). Never enable it where the accounts matter.
SEED_DEMO=false

# Web origins allowed to call this API from a browser (comma separated, matched exactly). Default: the back office app.
CORS_ORIGINS=http://backoffice.loong.localhost

# The AI gateway (services/ai) and the bearer token it expects. Leave AI_URL empty to turn the Copilot and the AI summary
# off: they then answer that they are having problems, while the admin's own switches stay as they were set.
AI_URL=
AI_TOKEN=
# How many AI requests one admin may make: a burst, then a number a minute (a Copilot question or a summary: one request
# each).
AI_USER_RATE_BURST=10
AI_USER_RATE_PER_MINUTE=20
