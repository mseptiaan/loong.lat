# driver-api. Copy to .env (gitignored) next to where you run it. Real environment variables win over .env, and an
# empty value counts as unset. The settings every service shares (LOG_LEVEL, SESSION_TTL, DATABASE_URL, KAFKA_BROKERS)
# are in backend/.env.example; DATABASE_URL must point at the driver database.
#
#   GROUP_PREFIX   consumer groups are <GROUP_PREFIX>.drivers / .dispatch / .fleet / .plan / .settings; defaults to "driver"

# The API of the driver app listens here.
HTTP_ADDR=:8081

# Web origins allowed to call this API from a browser (comma separated, matched exactly). Default: the driver app.
CORS_ORIGINS=http://driver.loong.localhost

# How often running routes are checked for delays; a route.delayed is published when one is 5 minutes late and at
# every further 5 minutes. A Go duration. Default: 30s.
DELAY_SWEEP_INTERVAL=30s

# The AI gateway (services/ai). This service has no AI feature of its own: it only answers settings.get with every
# AI flag off while this is empty, so screens do not offer what cannot work. Default: empty.
AI_URL=
