# Settings of the AI gateway. Copy to .env (gitignored) for local development.
# Real environment variables win over .env. Never commit real values.

AI_ADDR=:8091
# Shared secret that the callers (console-api, backoffice-api and the optimizer) present as a bearer token (their
# AI_TOKEN). Comma separated for one token per caller, in any order: each token has its own rate limit and shows up in
# logs as token0, token1, ...
AI_TOKEN=
# Run without AI_TOKEN, for a laptop only.
AI_DEV=true
LOG_LEVEL=info

# ---- Meta Model API (https://dev.meta.ai/docs) --------------------------------------------------------------
# The key stays in this service: callers never see it, and it is never logged. Without it the gateway still
# starts, GET /readyz says meta.configured=false, and every AI call answers 503.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Chat model for text, vision and tool use (Muse Spark) and the speech model (Muse Voice Transcribe).
META_MODEL=muse-spark-1.3-contributor
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# ---- limits -----------------------------------------------------------------------------------------------------
# Per caller (token): a burst of AI_RATE_BURST calls, then AI_RATE_PER_MINUTE a minute.
AI_RATE_PER_MINUTE=120
AI_RATE_BURST=30
# Calls to Meta running at once; beyond it the gateway answers 429 instead of queueing.
AI_MAX_IN_FLIGHT=16

# ---- profiles ---------------------------------------------------------------------------------------------------
# A caller names a profile (copilot, vision, intent, insights, review, report; transcribe for speech); the gateway fixes
# the rest.
# Override a profile with AI_<PROFILE>_<SETTING>; empty keeps the built-in value shown here.
#
#   profile     effort   max tokens  timeout  max body   takes
#   copilot     minimal  3000        60s      512 KiB    tools
#   vision      low      4000        60s      6 MiB      images (up to 4, each up to 4 MiB)
#   intent      minimal  1500        20s      64 KiB
#   insights    minimal  3000        45s      256 KiB
#   review      minimal  2000        20s      64 KiB   (the optimizer's reviewer: facts in, JSON out)
#   report      minimal  3000        45s      256 KiB  (the console's explanation of a quote's options)
#   transcribe  -        -           30s      8 MiB      one mono 16/24 kHz PCM WAV
#
# Effort is minimal, low, medium or high (the model refuses "none"). It is mostly time: a model call takes 2-3 s at
# minimal and 5-7 s at low. Copilot and insights run on minimal, which measured as accurate (every figure grounded in
# the tools) and 35-70% faster; set AI_COPILOT_EFFORT=low or AI_INSIGHTS_EFFORT=low to go back. Review and report run
# on minimal as well (the reviewer runs once per review round of a quote).
# MAX_TOKENS counts reasoning tokens too and must be at least 1500, or a call can come back with no content and
# finish_reason "length".
AI_COPILOT_MODEL=
AI_COPILOT_EFFORT=
AI_COPILOT_MAX_TOKENS=
AI_COPILOT_TIMEOUT=
AI_COPILOT_MAX_BODY_BYTES=
AI_VISION_MODEL=
AI_VISION_EFFORT=
AI_VISION_MAX_TOKENS=
AI_VISION_TIMEOUT=
AI_VISION_MAX_BODY_BYTES=
AI_INTENT_MODEL=
AI_INTENT_EFFORT=
AI_INTENT_MAX_TOKENS=
AI_INTENT_TIMEOUT=
AI_INTENT_MAX_BODY_BYTES=
AI_INSIGHTS_MODEL=
AI_INSIGHTS_EFFORT=
AI_INSIGHTS_MAX_TOKENS=
AI_INSIGHTS_TIMEOUT=
AI_INSIGHTS_MAX_BODY_BYTES=
AI_REVIEW_MODEL=
AI_REVIEW_EFFORT=
AI_REVIEW_MAX_TOKENS=
AI_REVIEW_TIMEOUT=
AI_REVIEW_MAX_BODY_BYTES=
AI_REPORT_MODEL=
AI_REPORT_EFFORT=
AI_REPORT_MAX_TOKENS=
AI_REPORT_TIMEOUT=
AI_REPORT_MAX_BODY_BYTES=
# transcribe uses META_TRANSCRIBE_MODEL unless AI_TRANSCRIBE_MODEL is set.
AI_TRANSCRIBE_MODEL=
AI_TRANSCRIBE_TIMEOUT=
AI_TRANSCRIBE_MAX_BODY_BYTES=
