# Settings of console-api. Copy to .env (gitignored) for local development; run from this directory or export
# the variables. Real environment variables win over .env. Never commit real values.
# The settings every service shares are explained in ../../.env.example.

HTTP_ADDR=:8083
LOG_LEVEL=info
SESSION_TTL=720h

# This service's own database (scripts/dev-up.sh prints a working URL) and the Kafka brokers.
DATABASE_URL=postgres://console:loong_dev@127.0.0.1:55432/console?sslmode=disable
KAFKA_BROKERS=localhost:19092

# The optimizer that prices the shipper's options, and the bearer token it expects.
OPTIMIZER_URL=http://127.0.0.1:8090
OPTIMIZER_TOKEN=
# How long to wait for a quote: more than the optimizer's own limit for a thorough or reviewed one (its
# OPTIMIZER_TIMEOUT_DEEP, 150s by default). Empty keeps 3m.
OPTIMIZER_CALL_TIMEOUT=

# Offer wallet.simulatePay, which credits a top-up without any payment. Development and tests only.
SIMULATE_PAYMENTS=false

# How long a plan cancel waits for the drivers' votes before it is aborted (Go duration).
CANCEL_TIMEOUT=2m

# The AI gateway (services/ai) and the bearer token it expects. Leave AI_URL empty to turn every AI feature off.
AI_URL=
AI_TOKEN=
# How many AI requests one customer may make: a burst, then a number a minute (Copilot question, photo, sentence,
# recording: one request each).
AI_USER_RATE_BURST=10
AI_USER_RATE_PER_MINUTE=20
# How often the worker that reads drivers' proof photos with the AI looks for a new one (Go duration). It runs only
# when AI_URL is set, and only for photos taken while the admin's vision switch is on. Empty keeps 2s.
PROOF_AI_POLL=

# Web origins allowed to call this API from a browser (comma separated, matched exactly). Default: the dashboard.
CORS_ORIGINS=http://console.loong.localhost
